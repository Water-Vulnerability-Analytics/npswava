month <- as.numeric(format(ym, "\%m"))
vis_clim <- data.frame(
  ym = ym,
  CF = ifelse(year < 2025, "Historical", "Warm Wet"),
  GCM = ifelse(year < 2025, "Historical", "CCSM4.rcp45"),
  tmean_F = 45 + 20 * sin(2 * pi * (month - 4) / 12) + 0.03 * (year - 1990),
  visitors = ifelse(
